<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GLRevival" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/systemBackground</item>
        <item name="android:colorBackground">@color/systemBackground</item>
        <item name="android:statusBarColor">@color/systemBackground</item>
        <item name="android:navigationBarColor">@color/systemBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:colorAccent">@color/systemBlue</item>
        <item name="android:colorPrimary">@color/systemBlue</item>
        <item name="android:colorPrimaryDark">@color/systemBlue</item>
        <item name="android:textColorPrimary">@color/label</item>
        <item name="android:textColorSecondary">@color/secondaryLabel</item>
        <item name="android:editTextColor">@color/label</item>
        <item name="android:editTextBackground">@color/secondarySystemBackground</item>
    </style>

    <style name="Theme.GLRevival.Glass" parent="Theme.GLRevival">
        <item name="android:windowBackground">@color/glassOverlay</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
